{
  "name": "hvt-svc-authoriser",
  "version": "1.0.0",
  "description": "Lambda authoriser for validating a user's Azure AD JWT and generating an access policy.",
  "license": "ISC",
  "author": "DVSA",
  "type": "module",
  "main": "handler.js",
  "scripts": {
    "start": "npm run build && sls offline start",
    "build": "bun package.ts",
    "build:dev": "bun package.ts",
    "build:copy": "bun package.ts",
    "test": "npm run test:unit -- --runInBand --coverage",
    "test:unit": "BRANCH=local jest --testMatch=\"**/*.unitTest.ts\"",
    "package": "bun package.ts && cd ${ZIP_NAME:-'authoriser'}; zip -r ../${ZIP_NAME:-'authoriser'}.zip *",
    "test-i": "echo \"No Current Int Tests\"",
    "security-checks": "git secrets --scan",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "sonar-scanner": "sonar-scanner",
    "generate-token": "bun scripts/generate-token.ts --env-file .env",
    "audit": "npm audit --omit=dev",
    "prepare": "husky",
    "tools-setup": "echo 'Nothing to do'"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@dvsa/appdev-api-common": "1.3.2",
    "@types/aws-lambda": "^8.10.161",
    "@types/bun": "1.3.11",
    "@types/jest": "^29.5.12",
    "@types/jest-plugin-context": "2.9.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.12.0",
    "bun": "1.3.11",
    "esbuild": "0.27.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-plugin-context": "2.9.0",
    "jest-sonar-reporter": "2.0.0",
    "osls": "3.63.2",
    "oxfmt": "0.45.0",
    "oxlint": "1.60.0",
    "serverless-dotenv-plugin": "6.0.0",
    "serverless-offline": "^14.5.0",
    "ts-jest": "^29.2.5",
    "typescript": "6.0.2"
  },
  "overrides": {
    "serverless": "npm:osls",
    "typescript": "$typescript"
  },
  "engines": {
    "node": "24.10.*",
    "npm": "11.6.*"
  },
  "jestSonar": {
    "reportPath": ".reports",
    "reportFile": "test-report.xml",
    "indent": 4
  }
}
